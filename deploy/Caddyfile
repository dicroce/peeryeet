peeryeet.com, www.peeryeet.com {
	root * /srv/peeryeet
	file_server
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data: blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
	}

	# Signaling WebSocket (plain localhost; Caddy terminates TLS)
	reverse_proxy /ws localhost:9000
}
