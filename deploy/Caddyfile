peeryeet.com, www.peeryeet.com {
	root * /srv/peeryeet
	file_server
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data: blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		# Always revalidate (cheap 304s via ETag); asset URLs are versioned at deploy.
		Cache-Control no-cache
	}

	# Signaling WebSocket and the hit counter (plain localhost; Caddy terminates TLS)
	@signal path /ws /hit
	reverse_proxy @signal localhost:9000
}
